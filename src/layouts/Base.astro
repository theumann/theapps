---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Widen the column for pages that hold a table rather than prose. */
  wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : `${SITE_TITLE} — Small apps that solve real problems`;
const canonical = new URL(Astro.url.pathname, Astro.site);
/** Social cards need an absolute URL; relative paths are ignored by scrapers. */
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="THeApps — small apps that solve real problems, built by Thierry Heumann"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>

  <body class="font-sans">
    <div
      class:list={[
        'mx-auto flex min-h-screen flex-col px-6',
        wide ? 'max-w-5xl' : 'max-w-3xl',
      ]}
    >
      <header class="flex items-center justify-between py-8">
        <a href="/" class="text-[21px] font-semibold tracking-tight">
          TH<span class="text-accent">e</span>Apps
        </a>
        <nav class="flex gap-6 text-[15px] text-muted">
          <a href="/#work" class="transition-colors hover:text-ink">Work</a>
          <a href="/about" class="transition-colors hover:text-ink">About</a>
        </nav>
      </header>

      <main class="flex-1 pb-24">
        <slot />
      </main>

      <footer
        class="flex flex-col gap-2 border-t border-line py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} Thierry Heumann</p>
        <p class="flex items-center gap-2">
          <a
            href="https://www.linkedin.com/in/thierryheumann/"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-ink"
          >
            LinkedIn
          </a>
          <span aria-hidden="true">|</span>
          <a href={`mailto:${CONTACT_EMAIL}`} class="transition-colors hover:text-ink">
            {CONTACT_EMAIL}
          </a>
        </p>
      </footer>
    </div>
  </body>
</html>
