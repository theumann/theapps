---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import ContactLinks from '../components/ContactLinks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : `${SITE_TITLE} — Small apps that solve real problems`;
const canonical = new URL(Astro.url.pathname, Astro.site);
/** Social cards need an absolute URL; relative paths are ignored by scrapers. */
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Applies a theme picked with the toggle before anything paints. Inline
        and blocking on purpose: a bundled script runs after first paint, which
        is the flash this exists to prevent. No saved choice means no
        attribute, and the CSS follows the OS. */}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="THeApps — small apps that solve real problems, built by Thierry Heumann"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap"
    />
  </head>

  <body class="font-sans">
    {/* One width for every page, so the header and footer never shift when
        navigating. */}
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col px-6">
      <header class="flex items-center justify-between py-8 [view-transition-name:site-header]">
        <a href="/" class="text-[21px] font-semibold tracking-tight">
          TH<span class="text-accent">e</span>Apps
        </a>
        <nav class="flex items-center gap-6 text-[15px] text-muted">
          <a href="/#apps" class="transition-colors hover:text-ink">Apps</a>
          {/* Trailing slashes are the canonical form: Cloudflare 308s `/about` to
              `/about/`, which costs a round-trip and seems to skip the crossfade. */}
          <a href="/stack/" class="transition-colors hover:text-ink">Stack</a>
          <a href="/about/" class="transition-colors hover:text-ink">About</a>
          <ThemeToggle />
        </nav>
      </header>

      <main class="flex-1 pb-24">
        <slot />
      </main>

      <footer
        class="flex flex-col gap-2 border-t border-line py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} Thierry Heumann</p>
        <ContactLinks email />
      </footer>
    </div>
  </body>
</html>
