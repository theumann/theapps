---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const apps = await getCollection('apps', ({ data }) => !data.draft);
  return apps.map((app) => ({
    params: { slug: app.id },
    props: { app },
  }));
};

const { app } = Astro.props;
const { name, domain, tagline, status, url, logo, stack, statusNote } = app.data;
const { Content } = await render(app);
---

<Base title={name} description={tagline}>
  <article class="pt-8">
    <a href="/#work" class="text-sm text-muted transition-colors hover:text-ink">
      &larr; All work
    </a>

    <header class="mt-8 border-b border-line pb-8">
      <div class="flex flex-wrap items-center gap-3">
        {
          logo ? (
            <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${name} in a new tab`}>
              <Image src={logo} alt={name} class="h-9 w-auto sm:h-10" />
            </a>
          ) : (
            <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{name}</h1>
          )
        }
        <StatusBadge status={status} />
      </div>

      <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">{tagline}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          url && (
            <a
              href={url}
              class="inline-flex items-center rounded-lg bg-ink px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
            >
              Visit {domain ?? 'site'} &rarr;
            </a>
          )
        }
        {
          stack.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {stack.map((tech) => (
                <li class="rounded-md border border-line px-2 py-1 text-xs text-muted">
                  {tech}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="prose mt-10">
      <Content />
      {
        statusNote && (
          <>
            <h2 class="flex items-center gap-2">
              Status <StatusBadge status={status} />
            </h2>
            <p>{statusNote}</p>
          </>
        )
      }
    </div>
  </article>
</Base>
