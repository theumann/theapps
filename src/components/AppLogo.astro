---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  logo: ImageMetadata;
  /** Same mark, recoloured for dark backgrounds. Omit if the light one already reads on dark. */
  logoDark?: ImageMetadata;
  name: string;
  class?: string;
}

const { logo, logoDark, name, class: className } = Astro.props;
---

{/* Both are in the HTML and CSS picks one, so the right logo is there on
    first paint whichever theme wins. The hidden one is display:none, which
    also keeps it out of the accessibility tree. */}
{
  logoDark ? (
    <>
      <Image src={logo} alt={name} class:list={[className, 'dark:hidden']} />
      <Image src={logoDark} alt={name} class:list={[className, 'hidden dark:inline']} />
    </>
  ) : (
    <Image src={logo} alt={name} class={className} />
  )
}
