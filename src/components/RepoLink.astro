---
interface Props {
  href: string;
  /** The app this repo belongs to, so screen readers get one distinct label per card. */
  name: string;
  /** Show the word "Source" beside the mark. The case study has room; a card doesn't. */
  labelled?: boolean;
  class?: string;
}

const { href, name, labelled = false, class: className } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`View ${name} source on GitHub`}
  title={`View ${name} source on GitHub`}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-lg text-muted transition-colors hover:text-ink',
    // Icon-only means a 16px target, and on a card it sits inside a full-area
    // overlay link — so a near-miss silently opens the case study instead.
    // Padding grows the tap target to 40px while the matching negative margin
    // keeps the layout put, and the hover background gives it a visible edge:
    // the cursor can't show one, since both sides of it are links.
    labelled ? '' : '-m-3 p-3 hover:bg-accent-soft',
    className,
  ]}
>
  <svg
    viewBox="0 0 16 16"
    class="h-4 w-4 shrink-0"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
    ></path>
  </svg>
  {labelled && <span class="text-sm font-medium">Source</span>}
</a>
