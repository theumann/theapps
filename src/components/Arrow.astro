---
interface Props {
  direction: 'left' | 'right';
  class?: string;
}

const { direction, class: className } = Astro.props;
---

{/* Drawn rather than typed: the font's ← and → are thin and sit off-center
    beside lowercase text. Stroke-based, so it follows the link's color. */}
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['h-3.5 w-3.5 shrink-0 transition-transform', className]}
>
  {
    direction === 'right' ? (
      <path d="M5 12h14M12 5l7 7-7 7" />
    ) : (
      <path d="M19 12H5M12 19l-7-7 7-7" />
    )
  }
</svg>
