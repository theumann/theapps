---
import AppLogo from './AppLogo.astro';
import StatusBadge from './StatusBadge.astro';
import RepoLink from './RepoLink.astro';
import Arrow from './Arrow.astro';
import { emphasisHtml } from '../lib/emphasis';
import type { CollectionEntry } from 'astro:content';

interface Props {
  app: CollectionEntry<'apps'>;
  /** Position in the grid, to stagger the fade-in (`.card-in` in global.css). */
  index?: number;
}

const { app, index = 0 } = Astro.props;
const { name, domain, tagline, status, url, logo, logoDark, repo } = app.data;
---

<div
  style={`--card-index: ${index}`}
  class="card-in group relative flex flex-col rounded-xl border border-line bg-surface p-6 transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[0_8px_24px_-12px_var(--shadow-tint)]"
>
  <a href={`/apps/${app.id}/`} class="absolute inset-0" aria-label={`${name} case study`}></a>

  <div class="relative z-10 flex items-start justify-between gap-4 pointer-events-none">
    <div class="pointer-events-none">
      {
        logo ? (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative inline-block pointer-events-auto"
            aria-label={`Open ${name} in a new tab`}
          >
            <AppLogo logo={logo} logoDark={logoDark} name={name} class="h-8 w-auto" />
          </a>
        ) : (
          <h3 class="text-lg font-semibold tracking-tight">{name}</h3>
        )
      }
      {domain && <p class="mt-0.5 text-sm text-muted">{domain}</p>}
    </div>
    <StatusBadge status={status} />
  </div>

  <p class="tagline mt-4 flex-1 text-[15px] leading-relaxed text-muted pointer-events-none" set:html={emphasisHtml(tagline)} />

  {/* The card-wide overlay link sits above everything, so anything clickable in
      here needs to opt back in with pointer-events-auto. */}
  <div class="relative z-10 mt-5 flex items-center justify-between gap-4 pointer-events-none">
    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-accent">
      Case study <Arrow direction="right" class="group-hover:translate-x-0.5" />
    </span>
    {repo && <RepoLink href={repo} name={name} class="pointer-events-auto" />}
  </div>
</div>
