---
import { Image } from 'astro:assets';
import StatusBadge from './StatusBadge.astro';
import RepoLink from './RepoLink.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const { name, domain, tagline, status, url, logo, repo } = app.data;
---

<div
  class="group relative flex flex-col rounded-xl border border-line bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[0_8px_24px_-12px_rgb(0_0_0/0.15)]"
>
  <a href={`/work/${app.id}`} class="absolute inset-0" aria-label={`Read more about ${name}`}></a>

  <div class="relative z-10 flex items-start justify-between gap-4 pointer-events-none">
    <div class="pointer-events-none">
      {
        logo ? (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative inline-block pointer-events-auto"
            aria-label={`Open ${name} in a new tab`}
          >
            <Image src={logo} alt={name} class="h-8 w-auto" />
          </a>
        ) : (
          <h3 class="text-lg font-semibold tracking-tight">{name}</h3>
        )
      }
      {domain && <p class="mt-0.5 text-sm text-muted">{domain}</p>}
    </div>
    <StatusBadge status={status} />
  </div>

  <p class="mt-4 flex-1 text-[15px] leading-relaxed text-muted pointer-events-none">{tagline}</p>

  {/* The card-wide overlay link sits above everything, so anything clickable in
      here needs to opt back in with pointer-events-auto. */}
  <div class="relative z-10 mt-5 flex items-center justify-between gap-4 pointer-events-none">
    <span class="text-sm font-medium text-accent">
      Read more <span class="inline-block transition-transform group-hover:translate-x-0.5">&rarr;</span>
    </span>
    {repo && <RepoLink href={repo} name={name} class="pointer-events-auto" />}
  </div>
</div>
